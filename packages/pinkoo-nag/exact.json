        }
      }
    },
    {
      "source": "nagState",
      "live": true,
      "answers": "NagState",
      "substitute": {
        "default": {
          "doses": [],
          "events": []
        }
      }
    },
    {
      "send": "scheduleNags",
      "permission": "none",
      "grants": [
        "device.alarms"
      ],
      "options": {
        "plan": "NagPlan"
      },
      "answers": null,
      "substitute": {
        "unsupported": [
          "web",
          "ios",
          "macos",
          "linux",
          "tvos",
          "windows",
          "terminal"
        ]
      },
      "contract": false
    },
    {
      "send": "resolveNags",
      "permission": "none",
      "options": {
        "keys": "string[]",
        "kind": "enum<taken|skipped|promised>",
        "until": "option<number>"
      },
      "answers": null,
      "substitute": {
        "unsupported": [
          "web",
          "ios",
          "macos",
          "linux",
          "tvos",
          "windows",
          "terminal"
        ]
      }
    },
    {
      "send": "ignoreNags",
      "permission": "none",
      "options": {
        "keys": "string[]"
      },
      "answers": null,
      "substitute": {
        "unsupported": [
          "web",
          "ios",
          "macos",
          "linux",
          "tvos",
          "windows",
          "terminal"
        ]
      }
    },
    {
      "send": "ackNagEvents",
      "permission": "none",
      "options": {
        "through": "string"
      },
      "answers": null,
      "substitute": {
        "unsupported": [
          "web",
          "ios",
          "macos",
          "linux",
          "tvos",
          "windows",
          "terminal"
        ]
      }
    },
    {
      "send": "nagScreen",
      "permission": "none",
      "options": {
        "showing": "bool",
        "keys": "string[]"
      },
      "answers": null,
      "substitute": {
        "unsupported": [
          "web",
          "ios",
          "macos",
          "linux",
          "tvos",
          "windows",
          "terminal"
        ]
      }
    },
    {
      "send": "leaveLockScreen",
      "permission": "none",
      "options": {
        "after": "number"
      },
      "answers": "NagLock",
      "substitute": {
        "unsupported": [
          "ios",
          "macos",
          "linux",
          "tvos",
          "windows",
          "terminal"
        ],
        "default": {
          "locking": false
        }
      }
    },
    {
      "send": "requestNagAccess",
      "permission": "none",
      "options": {
        "what": "enum<notifications|exactAlarms|fullScreen|overlay|promoted|battery|sleeping|sound>"
      },
      "answers": "NagStatus",
      "substitute": {
        "unsupported": [
          "web",
          "ios",
          "macos",
          "linux",
          "tvos",
          "windows",
          "terminal"
        ],
        "default": {
          "available": true,
          "notifications": "prompt",
          "channelBlocked": false,
          "exactAlarms": false,
          "fullScreen": false,
          "overlay": false,
          "promoted": "unavailable",
          "batteryUnrestricted": false,
          "backgroundRestricted": false,
          "standbyBucket": 10,
          "alarmVolume": 1,
          "dndAllowsAlarms": true,
          "maker": "",
          "talkBack": false
        }
      }
    },
    {
      "send": "previewNag",
      "permission": "none",
      "options": {
        "rung": "number",
        "after": "number",
        "title": "string",
        "body": "string",
        "route": "string"
      },
      "answers": null,
      "substitute": {
        "unsupported": [
          "web",
          "ios",
          "macos",
          "linux",
          "tvos",
          "windows",
          "terminal"
        ]
      }
    },
    {
      "send": "stopNagPreview",
      "permission": "none",
      "options": {},
      "answers": null,
      "substitute": {
        "unsupported": [
          "web",
          "ios",
          "macos",
          "linux",
          "tvos",
          "windows",
          "terminal"
        ]
      }
