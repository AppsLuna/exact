{
  "kind": "interface",
  "name": "@pinkoo/nag",
  "version": "2.0.0",
  "start": "load",
  "grants": [
    "device.alarms"
  ],
  "shapes": {
    "NagPlan": {
      "v": "number",
      "made": "number",
      "zone": "string",
      "locale": "string",
      "ladder": "NagLadder",
      "steps": "NagSteps",
      "alarm": "NagAlarm",
      "liveUpdate": "bool",
      "doses": "NagDose[]",
      "texts": "NagTexts",
      "mascot": "json<any>",
      "mascots": "json<any[]>",
      "stock": "option<NagStock>",
      "idle": "NagIdle"
    },
    "NagLadder": {
      "firstMin": "number",
      "thenMin": "number",
      "repeatFirstMin": "number",
      "repeatEveryMin": "number",
      "repeats": "number"
    },
    "NagSteps": {
      "bubble": "bool",
      "fullScreen": "bool",
      "unlock": "bool"
    },
    "NagAlarm": {
      "volume": "number"
    },
    "NagDose": {
      "key": "string",
      "group": "string",
      "name": "string",
      "miss": "string",
      "promiseUntil": "option<number>",
      "lineSeed": "number",
      "sound": "string",
      "alarm": "enum<off|afterAll|onTime>"
    },
    "NagTexts": {
      "title": "string",
      "body": "string",
      "publicTitle": "string",
      "publicBody": "string",
      "take": "string",
      "promise": "string",
      "notNow": "string",
      "pending": "string",
      "deadline": "string",
      "promiseChip": "string",
      "bubble": "string",
      "lines": "string[][]",
      "notNowRemind": "string",
      "notNowAlarm": "string",
      "notNowWait": "string",
      "alarmTitle": "string",
      "alarmBody": "string",
      "stop": "string",
      "service": "string",
      "channelNag": "string",
      "channelPending": "string",
      "channelNotice": "string",
      "channels": "NagChannelName[]"
    },
    "NagChannelName": {
      "sound": "string",
      "name": "string"
    },
    "NagStock": {
      "title": "string",
      "body": "string"
    },
    "NagIdle": {
      "afterDays": "number",
      "title": "string",
      "body": "string"
    },
    "NagState": {
      "doses": "NagDoseState[]",
      "events": "NagEvent[]",
      "front": "option<NagFront>"
    },
    "NagFront": {
      "nag": "number",
      "group": "string",
      "route": "string",
      "keys": "string[]",
      "names": "string[]",
      "at": "number",
      "step": "enum<notify|again|full|alarm|repeat|deadline>"
    },
    "NagDoseState": {
      "key": "string",
      "state": "enum<upcoming|ringing|pending|promised|resolved|lapsed>",
      "step": "option<enum<notify|again|full|alarm|repeat|deadline>>",
      "fires": "number",
      "rung": "number",
      "nextAt": "option<number>",
      "nextStep": "option<enum<notify|again|full|alarm|repeat|deadline>>",
      "alarmAt": "option<number>",
      "lastFiredAt": "option<number>"
    },
    "NagEvent": {
      "id": "string",
      "key": "string",
      "kind": "enum<fired|ignored|opened|lapsed>",
      "reason": "option<enum<notNow|timeout>>",
      "step": "option<enum<notify|again|full|alarm|repeat|deadline>>",
      "at": "number"
    },
    "NagStatus": {
      "available": "bool",
      "notifications": "enum<granted|denied|prompt>",
      "channelBlocked": "bool",
      "exactAlarms": "bool",
      "fullScreen": "bool",
      "overlay": "bool",
      "promoted": "enum<granted|denied|unavailable>",
      "batteryUnrestricted": "bool",
      "backgroundRestricted": "bool",
      "standbyBucket": "number",
      "alarmVolume": "number",
      "notificationVolume": "number",
      "ringerMode": "enum<normal|vibrate|silent>",
      "dndAllowsAlarms": "bool",
      "dndAllowsReminders": "bool",
      "channels": "NagChannel[]",
      "maker": "string"
    },
    "NagChannel": {
      "sound": "string",
      "id": "string",
      "importance": "number",
      "blocked": "bool",
      "changed": "bool"
    },
    "NagSoundPick": {
      "status": "enum<picked|unreadable|cancelled>",
