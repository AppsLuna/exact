{
  "kind": "interface",
  "name": "@pinkoo/nag",
  "version": "1.0.0",
  "start": "load",
  "grants": [
    "device.alarms"
  ],
  "shapes": {
    "NagPlan": {
      "v": "number",
      "made": "number",
      "zone": "string",
      "locale": "string",
      "ladder": "NagLadder",
      "rungs": "NagRung[]",
      "liveUpdate": "bool",
      "volume": "number[]",
      "doses": "NagDose[]",
      "texts": "NagTexts",
      "mascot": "json<any>",
      "mascots": "json<any[]>",
      "stock": "option<NagStock>",
      "idle": "NagIdle"
    },
    "NagLadder": {
      "firstMin": "number",
      "repeatMin": "number",
      "ringSec": "number"
    },
    "NagRung": {
      "ignores": "number",
      "add": "string[]"
    },
    "NagDose": {
      "key": "string",
      "group": "string",
      "name": "string",
      "miss": "string",
      "promiseUntil": "option<number>",
      "lineSeed": "number"
    },
    "NagTexts": {
      "title": "string",
      "body": "string",
      "publicTitle": "string",
      "publicBody": "string",
      "take": "string",
      "promise": "string",
      "notNow": "string",
      "pending": "string",
      "promiseChip": "string",
      "bubble": "string",
      "lines": "string[][]",
      "channelNag": "string",
      "channelPending": "string",
      "channelNotice": "string",
      "channelRing": "string"
    },
    "NagStock": {
      "title": "string",
      "body": "string"
    },
    "NagIdle": {
      "afterDays": "number",
      "title": "string",
      "body": "string"
    },
    "NagState": {
      "doses": "NagDoseState[]",
      "events": "NagEvent[]"
    },
    "NagDoseState": {
      "key": "string",
      "state": "enum<upcoming|ringing|pending|promised|resolved|lapsed>",
      "ignores": "number",
      "rung": "number",
      "nextAt": "option<number>",
      "lastFiredAt": "option<number>"
    },
    "NagEvent": {
      "id": "string",
      "key": "string",
      "kind": "enum<fired|ignored|opened|lapsed>",
      "reason": "option<enum<swipe|notNow|timeout|bubble>>",
      "at": "number"
    },
    "NagStatus": {
      "available": "bool",
      "notifications": "enum<granted|denied|prompt>",
      "channelBlocked": "bool",
      "exactAlarms": "bool",
      "fullScreen": "bool",
      "overlay": "bool",
      "promoted": "enum<granted|denied|unavailable>",
      "batteryUnrestricted": "bool",
      "backgroundRestricted": "bool",
      "standbyBucket": "number",
      "alarmVolume": "number",
      "dndAllowsAlarms": "bool",
      "maker": "string",
      "talkBack": "bool"
    },
    "NagLock": {
      "locking": "bool"
    }
  },
  "names": [
    {
      "source": "nagStatus",
      "live": true,
      "answers": "NagStatus",
      "substitute": {
        "default": {
          "available": true,
          "notifications": "prompt",
          "channelBlocked": false,
          "exactAlarms": false,
          "fullScreen": false,
          "overlay": false,
          "promoted": "unavailable",
          "batteryUnrestricted": false,
          "backgroundRestricted": false,
          "standbyBucket": 10,
          "alarmVolume": 1,
          "dndAllowsAlarms": true,
          "maker": "",
          "talkBack": false
        },
        "targets": {
          "web": {
            "available": false,
            "notifications": "denied",
            "channelBlocked": false,
            "exactAlarms": false,
            "fullScreen": false,
            "overlay": false,
            "promoted": "unavailable",
            "batteryUnrestricted": false,
            "backgroundRestricted": false,
            "standbyBucket": 0,
            "alarmVolume": 0,
            "dndAllowsAlarms": false,
            "maker": "",
