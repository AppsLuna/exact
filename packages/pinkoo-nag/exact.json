            "batteryUnrestricted": false,
            "backgroundRestricted": false,
            "standbyBucket": 0,
            "alarmVolume": 0,
            "dndAllowsAlarms": false,
            "maker": "",
            "talkBack": false
          },
          "tvos": {
            "available": false,
            "notifications": "denied",
            "channelBlocked": false,
            "exactAlarms": false,
            "fullScreen": false,
            "overlay": false,
            "promoted": "unavailable",
            "batteryUnrestricted": false,
            "backgroundRestricted": false,
            "standbyBucket": 0,
            "alarmVolume": 0,
            "dndAllowsAlarms": false,
            "maker": "",
            "talkBack": false
          },
          "windows": {
            "available": false,
            "notifications": "denied",
            "channelBlocked": false,
            "exactAlarms": false,
            "fullScreen": false,
            "overlay": false,
            "promoted": "unavailable",
            "batteryUnrestricted": false,
            "backgroundRestricted": false,
            "standbyBucket": 0,
