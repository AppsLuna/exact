{
  "kind": "implementation",
  "implements": "@pinkoo/nag@^2.0",
  "platform": "android",
  "targets": [
    "android"
  ],
  "shapes": {},
  "options": {},
  "names": [],
  "views": [],
  "hatches": [],
  "sources": {
    "kotlin": [
      "."
    ]
  },
  "manifest": {
    "receivers": [
      {
        "name": "pinkoo.nag.NagReceiver",
        "directBootAware": true
      },
      {
        "name": "pinkoo.nag.NagSystemReceiver",
        "directBootAware": true,
        "actions": [
          "android.intent.action.LOCKED_BOOT_COMPLETED",
          "android.intent.action.BOOT_COMPLETED",
          "android.intent.action.TIME_SET",
          "android.intent.action.TIMEZONE_CHANGED",
          "android.intent.action.MY_PACKAGE_REPLACED",
          "android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED"
        ]
      }
    ],
    "services": [
      {
        "name": "pinkoo.nag.NagService",
        "directBootAware": true,
        "foregroundServiceType": "systemExempted|specialUse",
        "subtype": "Keeps a medication reminder the person turned on: their reminder bubble over other apps for one reminder step, waiting for their next unlock to open the reminder after its full-screen step (until the next step, at most 2 hours), and the alarm they chose for a medication (up to 60 seconds)"
      }
    ],
    "permissions": [
      "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
      "android.permission.POST_PROMOTED_NOTIFICATIONS"
    ]
  },
  "artifacts": [],
  "class": "pinkoo.nag.NagModule"
}
