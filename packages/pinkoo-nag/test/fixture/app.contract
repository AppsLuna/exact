// The fixture of @pinkoo/nag: the engine's names read and sent as Pinkoo does, each answer shown by testId. The data
// module builds the plan (a dose on the next whole minute after a delay, a fast ladder) and sends it, as Pinkoo's does
// at every resume; the nag route is where the engine's taps, its full-screen nag, the bubble and an unlock open.
use nagStatus, nagState, NagStatus, NagState from "@pinkoo/nag"

routes nav
  home "/"
    nag "/nag/:group"

shape Said
  text: string

shape Time
  epochAtZero: number

component Fixture
  state url = ""
  resource status = nagStatus() as shape NagStatus
  resource doses = nagState() as shape NagState
  resource time = exactTime() as shape Time
  mutation planned as shape Said
  mutation acted as shape Said
  action follow(u: string)
    url = u
    nav = go(nav, u)
  action back
    nav = back(nav)
  action plan
    send planned = planNags(time.epochAtZero + performanceNow(), 60, 1, 1, 20)
  action planSoon
    send planned = planNags(time.epochAtZero + performanceNow(), 1, 1, 1, 20)
  action planIdle
    send planned = planIdle(time.epochAtZero + performanceNow())
  // Every nuisance from the first nag: the bubble and the unlock without climbing.
  action planAll
    send planned = planNags(time.epochAtZero + performanceNow(), 1, 1, 1, 0)
  action act(what: string)
    send acted = actNags(what, time.epochAtZero + performanceNow())
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` position="absolute" inset=0 gap=6 padding=16
            text `${status.available} ${status.notifications} exact=${status.exactAlarms} fsi=${status.fullScreen} overlay=${status.overlay} promoted=${status.promoted}` testId="status"
            text doses.doses.map(d => `${d.state}:${d.ignores}:${d.rung}`).join(",") testId="doses"
            text doses.events.map(v => v.kind).join(",") testId="events"
            text match planned { case some(p) => p.text, case none => "" } testId="planned"
            text match acted { case some(p) => p.text, case none => "" } testId="acted"
            text url testId="url"
            row gap=6 flex-wrap="wrap"
              button press=plan testId="plan"
                text "Plan"
              button press=planSoon testId="soon"
                text "Soon"
              button press=planIdle testId="idle"
                text "Idle"
              button press=planAll testId="all"
                text "All"
              button press=act("taken") testId="take"
                text "Take"
              button press=act("promised") testId="promise"
                text "Promise"
              button press=act("ack") testId="ack"
                text "Ack"
              button press=act("preview") testId="preview"
                text "Preview"
        if e.name == "nag"
          column navigationKey=`${e.id}` position="absolute" inset=0 gap=6 padding=16
            text `NAG ${e.params.group}` testId="nag-title"
            text url testId="nag-url"
            row gap=6 flex-wrap="wrap"
              button press=act("seen") testId="seen"
                text "Seen"
              button press=act("taken") testId="nag-take"
                text "Done"
              button press=act("promised") testId="nag-promise"
                text "Later"
              button press=act("leave") testId="leave"
                text "Leave"
              button press=back testId="nag-back"
                text "Back"
